<Window
	x:Class="EasyTax.App.Shell.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:local="using:EasyTax.App.Shell"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- The root paints the theme-aware background; a Window has none of its own, so without it a theme switch would only recolor the controls. -->
	<Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Custom title bar: the whole strip is draggable. -->
		<Grid x:Name="AppTitleBar" Height="40">
			<TextBlock
				x:Uid="Shell_Title"
				Margin="16,0,0,0"
				VerticalAlignment="Center"
				Style="{StaticResource CaptionTextBlockStyle}" />
		</Grid>

		<NavigationView
			x:Name="Navigation"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			IsPaneToggleButtonVisible="False"
			IsSettingsVisible="True"
			ItemInvoked="OnItemInvoked"
			OpenPaneLength="200"
			PaneDisplayMode="LeftCompact">

			<NavigationView.MenuItems>
				<NavigationViewItem x:Name="DashboardItem" x:Uid="Nav_Dashboard" Tag="Dashboard">
					<NavigationViewItem.Icon>
						<SymbolIcon Symbol="Home" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem x:Name="ClientsItem" x:Uid="Nav_Clients" Tag="Clients">
					<NavigationViewItem.Icon>
						<SymbolIcon Symbol="People" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<local:AppBar x:Name="AppBarControl" Visibility="Collapsed" />
				<Frame
					x:Name="ContentFrame"
					Grid.Row="1"
					FocusVisualPrimaryThickness="0"
					FocusVisualSecondaryThickness="0"
					IsTabStop="True" />
			</Grid>
		</NavigationView>
	</Grid>
</Window>
