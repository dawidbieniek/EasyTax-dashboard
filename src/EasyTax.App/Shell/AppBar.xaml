<UserControl
	x:Class="EasyTax.App.Shell.AppBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:local="using:EasyTax.App.Shell"
	xmlns:photos="using:EasyTax.App.Photos"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<photos:PhotoImageConverter x:Key="PhotoImageConverter" />

		<!--
			One template for every month. The colour comes from three overlapping labels of which exactly one is visible,
			so a month changing state only flips visibility: the button itself is never replaced.
		-->
		<DataTemplate x:Key="MonthTemplate" x:DataType="local:MonthItem">
			<Grid>
				<Button
					MinWidth="42"
					Padding="8,5"
					Click="OnMonthClick"
					IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
					Style="{StaticResource SubtleButtonStyle}"
					Tag="{x:Bind Month}">
					<Grid>
						<TextBlock
							FontWeight="SemiBold"
							Foreground="{ThemeResource SystemFillColorSuccessBrush}"
							Text="{x:Bind Label}"
							Visibility="{x:Bind IsAccounted, Mode=OneWay}" />
						<TextBlock
							FontWeight="SemiBold"
							Foreground="{ThemeResource SystemFillColorCautionBrush}"
							Text="{x:Bind Label}"
							Visibility="{x:Bind IsNotAccounted, Mode=OneWay}" />
						<TextBlock
							FontWeight="SemiBold"
							Text="{x:Bind Label}"
							Visibility="{x:Bind IsBeforeJoin, Mode=OneWay}" />
					</Grid>
				</Button>
				<Border
					Height="3"
					Margin="8,0"
					VerticalAlignment="Bottom"
					Background="{ThemeResource AccentFillColorDefaultBrush}"
					CornerRadius="1.5"
					IsHitTestVisible="False"
					Visibility="{x:Bind IsSelected, Mode=OneWay}" />
			</Grid>
		</DataTemplate>
	</UserControl.Resources>

	<Border
		Padding="16,8"
		Background="{ThemeResource LayerFillColorDefaultBrush}"
		BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		BorderThickness="0,0,0,1">

		<Grid ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Client picker, shared by every mode that shows the bar. -->
			<StackPanel
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="8">
				<PersonPicture
					Width="32"
					Height="32"
					DisplayName="{x:Bind ViewModel.SelectedClientName, Mode=OneWay}"
					ProfilePicture="{x:Bind ViewModel.SelectedClientPhoto, Mode=OneWay, Converter={StaticResource PhotoImageConverter}}" />
				<AutoSuggestBox
					x:Name="ClientBox"
					x:Uid="AppBar_ClientBox"
					Width="240"
					GotFocus="OnClientBoxGotFocus"
					IsEnabled="{x:Bind ViewModel.CanPickClient, Mode=OneWay}"
					LostFocus="OnClientBoxLostFocus"
					PlaceholderText="{x:Bind ViewModel.ClientPlaceholder, Mode=OneWay}"
					QuerySubmitted="OnClientQuerySubmitted"
					SuggestionChosen="OnClientSuggestionChosen"
					Text="{x:Bind ViewModel.SelectedClientName, Mode=OneWay}"
					TextChanged="OnClientTextChanged"
					TextMemberPath="FullName">
					<AutoSuggestBox.ItemTemplate>
						<DataTemplate x:DataType="local:ClientSuggestion">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PersonPicture
									Width="24"
									Height="24"
									DisplayName="{x:Bind FullName}"
									ProfilePicture="{x:Bind Photo, Converter={StaticResource PhotoImageConverter}}" />
								<TextBlock VerticalAlignment="Center" Text="{x:Bind FullName}" />
							</StackPanel>
						</DataTemplate>
					</AutoSuggestBox.ItemTemplate>
				</AutoSuggestBox>
				<Button
					x:Uid="AppBar_Previous"
					Command="{x:Bind ViewModel.SelectPreviousClientCommand}"
					IsEnabled="{x:Bind ViewModel.CanSelectPrevious, Mode=OneWay}"
					Style="{StaticResource SubtleButtonStyle}">
					<FontIcon FontSize="14" Glyph="&#xE76B;" />
				</Button>
				<Button
					x:Uid="AppBar_Next"
					Command="{x:Bind ViewModel.SelectNextClientCommand}"
					IsEnabled="{x:Bind ViewModel.CanSelectNext, Mode=OneWay}"
					Style="{StaticResource SubtleButtonStyle}">
					<FontIcon FontSize="14" Glyph="&#xE76C;" />
				</Button>
			</StackPanel>

			<!-- Year, months and accounted toggle: only in Full mode and only when there is a client. -->
			<Grid
				x:Name="MonthControls"
				Grid.Column="1"
				ColumnSpacing="12"
				Visibility="{x:Bind ViewModel.HasClients, Mode=OneWay}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ComboBox
					x:Uid="AppBar_Year"
					MinWidth="100"
					VerticalAlignment="Center"
					ItemsSource="{x:Bind ViewModel.Years, Mode=OneWay}"
					SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=OneWay}"
					SelectionChanged="OnYearSelectionChanged" />

				<ScrollViewer
					Grid.Column="1"
					HorizontalScrollBarVisibility="Hidden"
					HorizontalScrollMode="Auto"
					VerticalScrollMode="Disabled">
					<ItemsControl ItemTemplate="{StaticResource MonthTemplate}" ItemsSource="{x:Bind ViewModel.Months}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="2" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</ScrollViewer>

				<ToggleButton
					Grid.Column="2"
					MinWidth="140"
					VerticalAlignment="Center"
					Click="OnAccountedClick"
					Content="{x:Bind ViewModel.AccountedLabel, Mode=OneWay}"
					IsChecked="{x:Bind ViewModel.IsAccounted, Mode=OneWay}"
					IsEnabled="{x:Bind ViewModel.CanAccount, Mode=OneWay}"
					Style="{StaticResource StatusToggleButtonStyle}" />
			</Grid>
		</Grid>
	</Border>
</UserControl>
