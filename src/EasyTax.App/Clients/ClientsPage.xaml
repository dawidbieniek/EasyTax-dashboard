<Page
	x:Class="EasyTax.App.Clients.ClientsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:local="using:EasyTax.App.Clients"
	xmlns:photos="using:EasyTax.App.Photos"
	xmlns:tv="using:WinUI.TableView"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Page.Resources>
		<photos:PhotoImageConverter x:Key="PhotoImageConverter" />
	</Page.Resources>

	<Grid Padding="16" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="320" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
				x:Name="SearchBox"
				x:Uid="List_Search"
				Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
			<ToggleButton
				x:Uid="List_OnlyAlerts"
				Grid.Column="2"
				IsChecked="{x:Bind ViewModel.OnlyWithAlerts, Mode=TwoWay}" />
			<Button
				x:Name="AddButton"
				x:Uid="List_Add"
				Grid.Column="3"
				Click="OnAddClientClick"
				Style="{StaticResource AccentButtonStyle}" />
		</Grid>

		<InfoBar
			x:Uid="Clients_LoadError"
			Grid.Row="1"
			IsClosable="False"
			IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
			Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
			Severity="Error">
			<InfoBar.ActionButton>
				<Button x:Uid="Clients_Retry" Command="{x:Bind ViewModel.RetryCommand}" />
			</InfoBar.ActionButton>
		</InfoBar>

		<tv:TableView
			x:Name="ClientsGrid"
			Grid.Row="2"
			AutoGenerateColumns="False"
			CanFilterColumns="False"
			CanGroupColumns="False"
			IsReadOnly="True"
			ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
			RowContextFlyoutOpening="OnRowContextFlyoutOpening"
			Tapped="OnGridTapped"
			SelectionMode="Single"
			SelectionUnit="Row">

			<tv:TableView.RowContextFlyout>
				<MenuFlyout>
					<MenuFlyoutItem x:Uid="List_Open" Click="OnOpenClick" />
					<MenuFlyoutItem x:Name="SuspendItem" Click="OnSuspendClick" />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem
							x:Uid="List_Delete"
							Click="OnDeleteClick"
							Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
				</MenuFlyout>
			</tv:TableView.RowContextFlyout>

			<tv:TableView.Columns>
				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Name"
					Width="260"
					SortMemberPath="FullName">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<Grid
								Margin="12,0"
								VerticalAlignment="Center"
								ColumnSpacing="10"
								Opacity="{x:Bind RowOpacity}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<PersonPicture
									Width="28"
									Height="28"
									DisplayName="{x:Bind FullName}"
									ProfilePicture="{x:Bind Photo, Converter={StaticResource PhotoImageConverter}}" />
								<StackPanel
									Grid.Column="1"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Spacing="6">
									<TextBlock
										VerticalAlignment="Center"
										Text="{x:Bind FullName}"
										TextTrimming="CharacterEllipsis" />
									<!-- Alert marker: red when something is critical, amber for a warning; the tooltip says what. -->
									<FontIcon
										VerticalAlignment="Center"
										FontSize="14"
										Foreground="{ThemeResource SystemFillColorCriticalBrush}"
										Glyph="&#xE7BA;"
										ToolTipService.ToolTip="{x:Bind AlertTooltip}"
										Visibility="{x:Bind HasCriticalAlert}" />
									<FontIcon
										VerticalAlignment="Center"
										FontSize="14"
										Foreground="{ThemeResource SystemFillColorCautionBrush}"
										Glyph="&#xE7BA;"
										ToolTipService.ToolTip="{x:Bind AlertTooltip}"
										Visibility="{x:Bind HasWarningAlert}" />
								</StackPanel>
								<!-- A tinted chip that is never cut off: the name gives way (ellipsis) before the chip does. -->
								<Border
									Grid.Column="2"
									Padding="8,1"
									VerticalAlignment="Center"
									Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
									BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
									BorderThickness="1"
									CornerRadius="9"
									Visibility="{x:Bind IsSuspended}">
									<TextBlock
										x:Uid="List_Suspended"
										Foreground="{ThemeResource SystemFillColorCautionBrush}"
										Style="{StaticResource CaptionTextBlockStyle}" />
								</Border>
							</Grid>
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Nip"
					Width="130"
					SortMemberPath="Nip">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind Nip}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Bank"
					Width="160"
					SortMemberPath="BankName">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind BankName}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Tax"
					Width="140"
					SortMemberPath="TaxType">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind TaxType}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Relief"
					Width="150"
					SortMemberPath="Relief">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind Relief}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Phone"
					Width="120"
					SortMemberPath="Phone">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind Phone}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Email"
					Width="200"
					SortMemberPath="Email">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind Email}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>

				<tv:TableViewTemplateColumn
					x:Uid="List_Column_Month"
					Width="130"
					SortMemberPath="MonthStatus">
					<tv:TableViewTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="local:ClientRow">
							<TextBlock
								Margin="12,0"
								VerticalAlignment="Center"
								Opacity="{x:Bind RowOpacity}"
								Text="{x:Bind MonthStatus}" />
						</DataTemplate>
					</tv:TableViewTemplateColumn.CellTemplate>
				</tv:TableViewTemplateColumn>
			</tv:TableView.Columns>
		</tv:TableView>
	</Grid>
</Page>
