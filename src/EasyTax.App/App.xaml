<Application
	x:Class="EasyTax.App.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
			</ResourceDictionary.MergedDictionaries>

			<!--
				Status colours: Material Design green / amber / red instead of the Windows ones (which clash on dark backgrounds).
				Darker shades on light backgrounds, lighter ones on dark. Keep in sync with ChartPalette.cs (used by the charts).
				Everything that reads the SystemFillColor* brushes (month labels, toggle buttons, info bars) picks these up.
			-->
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#388E3C" />
					<SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#E8F5E9" />
					<SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FF6F00" />
					<SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF8E1" />
					<SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#D32F2F" />
					<SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FFEBEE" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#66BB6A" />
					<SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#3366BB6A" />
					<SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFCA28" />
					<SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#33FFCA28" />
					<SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#EF5350" />
					<SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#33EF5350" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<!-- Button with red text, for the confirm button of destructive dialogs (delete). -->
			<Style x:Key="DestructiveButtonStyle" TargetType="Button">
				<Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
				<Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="11,5,11,6" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Grid x:Name="Root" Background="Transparent">
								<Border
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}" />
								<Border
									x:Name="Overlay"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
								<ContentPresenter
									Padding="{TemplateBinding Padding}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Foreground="{TemplateBinding Foreground}" />

								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Overlay.Opacity" Value="1" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Overlay.Opacity" Value="1" />
												<Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Disabled">
											<VisualState.Setters>
												<Setter Target="Root.Opacity" Value="0.5" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--
				Toggle button whose state changes are instant. The default template fades between states, which looks like a click
				whenever the state changes because of data (another month selected). Checked = green.
			-->
			<Style x:Key="StatusToggleButtonStyle" TargetType="ToggleButton">
				<Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="11,5,11,6" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<Grid x:Name="Root" Background="Transparent">
								<Border
									x:Name="Surface"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}" />
								<Border
									x:Name="Overlay"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
								<ContentPresenter
									x:Name="ContentPresenter"
									Padding="{TemplateBinding Padding}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Foreground="{TemplateBinding Foreground}" />

								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Overlay.Opacity" Value="1" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Overlay.Opacity" Value="1" />
												<Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Disabled">
											<VisualState.Setters>
												<Setter Target="Surface.Opacity" Value="0.5" />
												<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Checked">
											<VisualState.Setters>
												<Setter Target="Surface.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
												<Setter Target="Surface.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="CheckedPointerOver">
											<VisualState.Setters>
												<Setter Target="Surface.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
												<Setter Target="Surface.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
												<Setter Target="Overlay.Opacity" Value="1" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="CheckedPressed">
											<VisualState.Setters>
												<Setter Target="Surface.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
												<Setter Target="Surface.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
												<Setter Target="Overlay.Opacity" Value="1" />
												<Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- Card look shared by the dashboard and the client page. -->
			<Style x:Key="CardStyle" TargetType="Border">
				<Setter Property="Padding" Value="16" />
				<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="8" />
			</Style>

			<Style x:Key="CardTitleStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
				<Setter Property="Margin" Value="0,0,0,4" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
